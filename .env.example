# TuniEdu Platform Environment Configuration Template
# Timezone Rule: Official school year calculations must follow Africa/Tunis

# -----------------------------------------------------------------------------
# Database Configuration (PostgreSQL 16)
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://CHANGE_ME:CHANGE_ME@localhost:5432/tuniedu_db?schema=public"

# -----------------------------------------------------------------------------
# Cache & Task Queue (Redis 7)
# -----------------------------------------------------------------------------
REDIS_URL="redis://CHANGE_ME:CHANGE_ME@localhost:6379"

# -----------------------------------------------------------------------------
# Object Storage (MinIO S3 Compatible)
# -----------------------------------------------------------------------------
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="CHANGE_ME"
S3_SECRET_KEY="CHANGE_ME"
S3_BUCKET_MANUSCRIPTS="tuniedu-manuscripts-raw"
S3_BUCKET_BOARDS="tuniedu-boards-rendered"
S3_BUCKET_VIDEOS="tuniedu-videos-hls"
S3_BUCKET_REPLAYS="tuniedu-live-replays"
S3_REGION="us-east-1"

# -----------------------------------------------------------------------------
# WebRTC Live Streaming Infrastructure (LiveKit SFU)
# -----------------------------------------------------------------------------
LIVEKIT_URL="http://CHANGE_ME:7880"
LIVEKIT_API_KEY="CHANGE_ME"
LIVEKIT_API_SECRET="CHANGE_ME"


# -----------------------------------------------------------------------------
# National Payment Gateway Simulation (Flouci / Konnect / GPG)
# -----------------------------------------------------------------------------
FLOUCI_APP_TOKEN="CHANGE_ME"
FLOUCI_APP_SECRET="CHANGE_ME"
WEBHOOK_SECRET_KEY="CHANGE_ME"

# -----------------------------------------------------------------------------
# Platform & Security Settings
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
JWT_SECRET="CHANGE_ME"
NEXTAUTH_SECRET="CHANGE_ME"
NEXTAUTH_URL="http://CHANGE_ME:3000"
MEDIA_TOKEN_SECRET="CHANGE_ME"
PLATFORM_COMMISSION_BPS=2000 # 20% Platform fee (2000 basis points)
AUTHOR_ROYALTY_BPS=8000     # 80% Net Author share (8000 basis points)
DEFAULT_TIMEZONE="Africa/Tunis"
NODE_ENV="development"

# Seed password for the initial admin/professor accounts created by `npm run prisma:seed`.
# Change this before seeding in any real environment. Dev fallback: "TuniEdu@2026".
SEED_DEFAULT_PASSWORD="CHANGE_ME"

# -----------------------------------------------------------------------------
# AI Personal Tutor (OpenRouter — OpenAI-compatible chat completions)
# -----------------------------------------------------------------------------
OPENROUTER_API_KEY="CHANGE_ME"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
AI_MODEL="openai/gpt-4o-mini"
AI_REQUEST_TIMEOUT_MS="25000"

# -----------------------------------------------------------------------------
# Payment simulation (SANDBOX ONLY — /api/payments/simulate 404s in production unless =1)
# -----------------------------------------------------------------------------
ALLOW_PAYMENT_SIMULATION="1"

# -----------------------------------------------------------------------------
# Notifications (email + SMS). Driver "log" prints to stdout (dev); "http"
# posts to NOTIFICATIONS_WEBHOOK_URL/email and /sms with a bearer token;
# "smtp" sends email directly via SMTP_URL (dependency-free client, smtp(s)://).
# When Redis is configured, dispatch is queued (retries) via the notifications
# worker; otherwise it is delivered inline.
# -----------------------------------------------------------------------------
NOTIFICATIONS_DRIVER="log"
NOTIFICATIONS_FROM_EMAIL="no-reply@tuniedu.tn"
NOTIFICATIONS_FROM_SMS="TUNIEDU"
NOTIFICATIONS_WEBHOOK_URL=""
NOTIFICATIONS_WEBHOOK_TOKEN=""
# e.g. smtps://user:pass@mail.tuniedu.tn:465  or  smtp://user:pass@mail.tuniedu.tn:587
SMTP_URL=""
